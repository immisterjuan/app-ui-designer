{
  "id": "tailwind-starter-kit",
  "name": "Tailwind Starter Kit (example)",
  "version": "1.0.0",
  "css": ["https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css"],
  "license": "MIT",
  "mapping": {
    "button": { "tag": "button", "className": "bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded" },
    "card": { "tag": "div", "className": "bg-white rounded shadow p-4" },
    "text": { "tag": "p", "className": "text-gray-800" },
    "input": { "tag": "input", "className": "border rounded px-3 py-2 w-full" },
    "alert": { "tag": "div", "className": "bg-yellow-100 border-l-4 border-yellow-500 text-yellow-700 p-4" }
  }
}
